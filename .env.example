# GEMINI_API_KEY: Optional for full-stack Node/Express AI receipt vision extraction.
# When deployed statically to GitHub Pages without a Node server, Shoebox automatically
# runs in client-side mode (text receipt parser, sample pile, manual entry, local persistence).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Server port for full-stack mode (defaults to 3000).
PORT="3000"

# APP_URL: Hosted URL for self-referential links.
APP_URL="http://localhost:3000"
